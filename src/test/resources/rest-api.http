### Start a new conversation with the AI assistant
# This request sends an empty history to simulate the first turn of a conversation.
POST http://localhost:9944/api/chat
Content-Type: application/json

{
  "history": [],
  "query": "I am looking for a ceramic mug for coffee"
}

### Continue a conversation (multi-turn example)
# To test a follow-up question, copy the response from the previous request
# and use it to build the history for this new request.
POST http://localhost:9944/api/chat
Content-Type: application/json

{
  "history": [
    {
      "role": "user",
      "content": "I am looking for a ceramic mug for coffee"
    },
    {
      "role": "assistant",
      "content": "It sounds like you're interested in purchasing a stylish ceramic beverage mug suitable for your daily use. Based on the descriptions provided:\n\n1. The first product (ed544b6c-b864-4e8a-aeca-8ed4b169285d) is a household mosquick® ceramic mug designed for both drinking coffee or tea and includes an accompanying lid with spoon. This item offers smart convenience as well as style, making it suitable for your needs at work and home.\n\nAs these descriptions are fictional product IDs without real-world details on availability in specific stores, I recommend visiting the online store where you found them to purchase this mug if they suit your preference. If not available there, checking other e-commerce platforms might yield positive results as well."
    }
  ],
  "query": "What other products do you have?"
}
